---
// src/components/WhyUs/WhyUs4R.astro
import { t } from "i18n:astro";
import { getImage } from "astro:assets";

// Import image
import about1 from "@assets/images/about1.jpg";

// Optimize image
const optimizedAbout1 = await getImage({ src: about1, format: 'webp', width: 522 });
const optimizedAbout1Mobile = await getImage({ src: about1, format: 'webp', width: 600 });

// Create reasons array for easy mapping
const reasons = [
  {
    number: "01",
    title: t("home:whyUs.reason1.title"),
    description: t("home:whyUs.reason1.description")
  },
  {
    number: "02",
    title: t("home:whyUs.reason2.title"),
    description: t("home:whyUs.reason2.description")
  },
  {
    number: "03",
    title: t("home:whyUs.reason3.title"),
    description: t("home:whyUs.reason3.description")
  },
  {
    number: "04",
    title: t("home:whyUs.reason4.title"),
    description: t("home:whyUs.reason4.description")
  }
];
---

<!-- ============================================ -->
<!--                   Steps                      -->
<!-- ============================================ -->
<section id="steps-1712">
    <picture class="cs-background">
        <!--Mobile Image-->
        <source media="(max-width: 600px)" srcset={optimizedAbout1Mobile.src} type="image/webp" />
        <!--Tablet and above Image-->
        <source media="(min-width: 601px)" srcset={optimizedAbout1.src} type="image/webp" />
        <img loading="lazy" decoding="async" src={about1.src} alt={t("home:whyUs.imageAlt")} width="522" height="609" aria-hidden="true" />
    </picture>
    <div class="cs-container">
        <div class="cs-wrapper">
            <div class="cs-content">
                <span class="cs-topper">{t("home:whyUs.topper")}</span>
                <h2 class="cs-title">{t("home:whyUs.title")}</h2>
            </div>
            <ul class="cs-card-group">
                {reasons.map((reason) => (
                    <li class="cs-item">
                        <span class="cs-number">{reason.number}</span>
                        <div class="cs-flex">
                            <h3 class="cs-h3">{reason.title}</h3>
                            <p class="cs-item-text">
                                {reason.description}
                            </p>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>

<style lang="less">

  /*-- -------------------------- -->
<---          Steps             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #steps-1712 {
        overflow: hidden;
        position: relative;
        z-index: 1;

        .cs-container {
            max-width: (1280/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
        }

        .cs-wrapper {
            /* changes to 630px on tablet */
            max-width: (500/16rem);
            margin: auto;
            padding: var(--sectionPadding);
            display: flex;
            flex-direction: column;
            /* 48px - 64px */
            gap: clamp(3rem, 6vw, 4rem);
        }

        .cs-content {
            /* set text align to center if content needs to be centrally aligned */
            text-align: left;
            width: 100%;
            display: flex;
            flex-direction: column;
            /* aligns content to the left, set to center to centrally align */
            align-items: flex-start;
        }

        .cs-title {
            margin: 0;
        }

        .cs-card-group {
            margin: 0;
            padding: 0;
            display: grid;
            justify-items: center;
            align-items: stretch;
            /* 24px - 32px */
            gap: clamp(1.5rem, 3vw, 2rem);
            grid-auto-flow: row;
        }

        .cs-item {
            list-style: none;
            display: flex;
            align-items: flex-start;
            position: relative;
        }

        .cs-number {
            /* 80px - 100px */
            font-size: clamp(5rem, 9vw, 6.25rem);
            font-weight: 900;
            line-height: 1.2em;
            letter-spacing: -2px;
            margin-right: (-20/16rem);
            color: var(--primary);
            opacity: 0.12;
            display: block;
        }

        .cs-h3 {
            font-size: (25/16rem);
            font-weight: 700;
            line-height: 1.2em;
            margin: 0 0 (12/16rem) 0;
            color: var(--headerColor);
        }

        .cs-item-text {
            /* 14px - 16px */
            font-size: clamp(0.875rem, 2vw, 1rem);
            line-height: 1.5em;
            text-align: left;
            margin: 0;
            color: var(--bodyTextColor);
        }

        .cs-background {
            width: 100%;
            height: (360/16rem);
            display: block;

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #steps-1712 {
        padding: var(--sectionPadding);

        .cs-container {
            padding: 0;
            justify-content: flex-start;
        }

        .cs-title {
            margin: 0;
        }

        .cs-wrapper {
            width: 65vw;
            max-width: (630/16rem);
            margin: 0;
            padding: 0;
        }

        .cs-card-group {
            /* 16px - 32px */
            gap: clamp(1rem, 3vw, 2rem);
        }

        .cs-item {
            flex-direction: row;
        }

        .cs-picture {
            width: (180/16rem);
            height: (180/16rem);
        }

        .cs-background {
            width: 30%;
            height: auto;
            position: absolute;
            top: 0;
            bottom: 0;
            right: 0;
        }
    }
}

/* Desktop - 1024px */
@media only screen and (min-width: 64rem) {
    #steps-1712 {
        .cs-wrapper {
            width: 50vw;
        }

        .cs-background {
            width: 50vw;
            left: 50%;
            right: auto;
            margin-left: (128/16rem);
        }
    }
}

/* Dark Mode */
@media only screen and (min-width: 0rem) {
    body.dark-mode {
        #steps-1712 {
            .cs-title,
            .cs-h3,
            .cs-item-text {
                color: var(--bodyTextColorWhite);
            }

            .cs-item-text {
                opacity: 0.8;
            }
        }
    }
}
                                
</style>